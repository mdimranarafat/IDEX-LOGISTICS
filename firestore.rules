rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Completed Projects — public can only read published projects.
    // Admins can read everything and create/update/delete.
    match /projects/{projectId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Users collection holds the { role: "admin" } flag used above.
    // Nobody writes to it from the client — manage roles from the
    // Firebase console or a trusted backend (Admin SDK).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
